# ====================================== camaras de reconhecimento facial
DEF FACECAM_CHECKPOINT Robot {
  translation -5 -1.25 2.15
  rotation 0 0 1 -1.5708
  name "facecam_checkpoint"
  controller "face_id_agent"
  controllerArgs [
    "--gate=checkpoint"
  ]
  children [
    Emitter {
      channel 1
    }
    Receiver {
      channel 1
    }
    Pose {
      rotation 0 1 0 0.45
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.15 0.15 0.18 roughness 0.4 metalness 0.4 }
          geometry Box { size 0.14 0.07 0.07 }
        }
        Camera {
          translation 0.08 0 0
          name "camera"
          fieldOfView 1.2
          width 320
          height 240
          recognition Recognition {
            maxRange 6
          }
        }
      ]
    }
  ]
}
DEF FACECAM_DATACENTER Robot {
  translation 8 0.78 2.15
  rotation 0 0 1 -1.5708
  name "facecam_datacenter"
  controller "face_id_agent"
  controllerArgs [
    "--gate=datacenter"
  ]
  children [
    Emitter {
      channel 1
    }
    Receiver {
      channel 1
    }
    Pose {
      rotation 0 1 0 0.45
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.15 0.15 0.18 roughness 0.4 metalness 0.4 }
          geometry Box { size 0.14 0.07 0.07 }
        }
        Camera {
          translation 0.08 0 0
          name "camera"
          fieldOfView 1.2
          width 320
          height 240
          recognition Recognition {
            maxRange 6
          }
        }
      ]
    }
  ]
}

# ====================================== sensores de movimento (PIR) por zona
DEF PIR_LOBBY Robot {
  translation -7.5 -1.18 2.3
  rotation 0 0 1 -1.5708
  name "pir_lobby"
  controller "motion_agent"
  controllerArgs [
    "--zone=lobby"
  ]
  children [
    Emitter {
      channel 1
    }
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.9 0.88 roughness 0.7 metalness 0 }
      geometry Box { size 0.1 0.06 0.09 }
    }
    LED {
      translation 0.05 0 0.02
      name "led"
      color [
        1 0 0
      ]
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 roughness 0.5 metalness 0 }
          geometry Sphere { radius 0.012 }
        }
      ]
    }
    DistanceSensor {
      rotation 0 1 0 0.35
      name "ds_center"
      lookupTable [
        0 0 0
        8 8 0
      ]
    }
    Pose {
      rotation 0 0 1 0.55
      children [
        DistanceSensor {
          rotation 0 1 0 0.3
          name "ds_left"
          lookupTable [
            0 0 0
            8 8 0
          ]
        }
      ]
    }
    Pose {
      rotation 0 0 1 -0.55
      children [
        DistanceSensor {
          rotation 0 1 0 0.3
          name "ds_right"
          lookupTable [
            0 0 0
            8 8 0
          ]
        }
      ]
    }
  ]
}
