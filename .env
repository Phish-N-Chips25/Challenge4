COMPOSE_PROJECT_NAME=booster-t1
WEBOTS_PORT=1234
ROBOT_NAME=T1_release
CONTAINER_NAME=booster-t1-ros
IMAGE_NAME=booster-t1-webots-ros:humble
DOCKER_PLATFORM=linux/amd64

# Platform-specific files override these defaults when helper scripts run.
WEBOTS_HOST_IP=host.docker.internal
WEBOTS_PATH=webots
ENABLE_GPU=false
USE_HOST_NETWORK=false
