DEF RACK_1 Robot {
  translation 6.8 5.3 0
  name "rack_1"
  model "server_rack"
  controller "cyber_sentinel_agent"
  children [
    Emitter {
      channel 1
    }
    Pose {
      translation 0 0 1
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.12 0.12 0.14 roughness 0.4 metalness 0.6 }
          geometry Box { size 0.7 0.9 2 }
        }
      ]
    }
    LED {
      translation 0 -0.47 1.7
      name "status_led"
      color [
        0 1 0
        1 0 0
      ]
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 roughness 0.5 metalness 0 }
          geometry Sphere { radius 0.03 }
        }
      ]
    }
  ]
  boundingObject Pose {
    translation 0 0 1
    children [
      Box { size 0.7 0.9 2 }
    ]
  }
}
