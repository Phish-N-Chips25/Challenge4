#VRML_SIM R2023b utf8
# SentinelMAS — Ambiente de empresa para o demonstrador do Challenge 4.
# Zonas: lobby, corredor (checkpoint facial), 4 salas de trabalho, datacenter
# (acesso por reconhecimento facial), sala de convívio. Sensores PIR em todas
# as zonas, robô de patrulha e agentes CyberSentinel nos servidores.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/apartment_structure/protos/Wall.proto"
EXTERNPROTO "DoorNoCol.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/tables/protos/Desk.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/tables/protos/Table.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/chairs/protos/OfficeChair.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/chairs/protos/WoodenChair.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/computers/protos/Monitor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/computers/protos/Keyboard.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/living_room_furniture/protos/Sofa.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/plants/protos/PottedTree.proto"

WorldInfo {
  title "SentinelMAS - ambiente de empresa"
  info [
    "Demonstrador Webots do SentinelMAS (Challenge 4)."
    "Lobby com checkpoint facial, 4 salas de trabalho, datacenter com"
    "controlo de acesso facial, sala de convivio, sensores PIR por zona,"
    "robo de patrulha e agentes CyberSentinel nos servidores."
  ]
  basicTimeStep 32
}
Viewpoint {
  position 0 -20 18
  orientation 1 0 0 0.84
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 28 22
  name "ground"
}

