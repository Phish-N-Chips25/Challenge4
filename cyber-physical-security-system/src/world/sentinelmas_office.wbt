# ============================================================ robo de patrulha
DEF PATROL_ROBOT Robot {
  translation 9 0 0
  rotation 0 0 1 3.14159
  name "patrol_robot"
  model "patrol_robot"
  controller "patrol_agent"
  supervisor TRUE
  recognitionColors [
    0.1 0.3 0.9
  ]
  children [
    Emitter {
      channel 1
    }
    Receiver {
      channel 1
    }
    Pose {
      translation 0 0 0.25
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.15 0.35 roughness 0.5 metalness 0.4 }
          geometry Cylinder { height 0.4 radius 0.28 }
        }
      ]
    }
    Pose {
      translation 0.2 0.22 0.08
      rotation 1 0 0 1.5708
      children [
        DEF WHEEL_SHAPE Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 roughness 0.9 metalness 0 }
          geometry Cylinder { height 0.05 radius 0.08 }
        }
      ]
    }
    Pose {
      translation 0.2 -0.22 0.08
      rotation 1 0 0 1.5708
      children [
        USE WHEEL_SHAPE
      ]
    }
    Pose {
      translation -0.2 0.22 0.08
      rotation 1 0 0 1.5708
      children [
        USE WHEEL_SHAPE
      ]
    }
    Pose {
      translation -0.2 -0.22 0.08
      rotation 1 0 0 1.5708
      children [
        USE WHEEL_SHAPE
      ]
    }
    Pose {
      translation 0 0 0.7
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.3 0.3 0.32 roughness 0.5 metalness 0.6 }
          geometry Cylinder { height 0.5 radius 0.04 }
        }
      ]
    }
    Camera {
      translation 0.05 0 0.97
      name "patrol_camera"
      fieldOfView 1.3
      width 320
      height 240
      recognition Recognition {
        maxRange 5
      }
    }
    LED {
      translation 0 0 1.05
      name "beacon"
      color [
        1 0 0
      ]
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.3 0.05 0.05 roughness 0.4 metalness 0 }
          geometry Sphere { radius 0.06 }
        }
      ]
    }
  ]
  boundingObject Pose {
    translation 0 0 0.5
    children [
      Cylinder { height 1 radius 0.3 }
    ]
  }
}

